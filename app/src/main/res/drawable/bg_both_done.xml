<?xml version="1.0" encoding="utf-8"?>

<!-- "You both finished today", Pearl look: the dashboard's pearl card with a lavender rim, like a
     finished tile, so it stands out by glowing rather than by colour. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Lilac edge showing below the face -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#D6C8EE" android:endColor="#E7CFE8" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Pearl face -->
    <item android:bottom="5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#FFFFFF"
                android:centerColor="#EFE6FF"
                android:endColor="#E3F1FF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- A faint blush in the bottom right -->
    <item android:bottom="5dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="1.0"
                android:centerY="1.0"
                android:gradientRadius="180dp"
                android:startColor="#80FBE3F2"
                android:endColor="#00FBE6F3" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Shine along the top -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:height="44dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#F2FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="22dp" android:topRightRadius="22dp" />
        </shape>
    </item>
    <!-- White rim -->
    <item android:bottom="5dp">
        <shape android:shape="rectangle">
            <stroke android:width="1.5dp" android:color="#B39DDB" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>

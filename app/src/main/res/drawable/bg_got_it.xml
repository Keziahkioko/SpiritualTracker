<?xml version="1.0" encoding="utf-8"?>
<!-- "Got it" / "I've learned it": the app's own purple-to-magenta gradient (as on the headers and
     the bell icons), made glossy: deeper at the bottom, a white shine across the upper half, a
     small sparkle, a soft reflected light along the bottom edge and a thin bright rim. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#40FFFFFF">
    <item>
        <layer-list>
            <!-- Body: deep violet to magenta, left to right -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="0"
                        android:startColor="#6A3CC8"
                        android:centerColor="#7E45C4"
                        android:endColor="#A23FB5" />
                    <corners android:radius="26dp" />
                </shape>
            </item>
            <!-- Depth: lighter at the top, deeper at the bottom -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#22FFFFFF"
                        android:centerColor="#00000000"
                        android:endColor="#40240A4D" />
                    <corners android:radius="26dp" />
                </shape>
            </item>
            <!-- Reflected light along the bottom edge -->
            <item android:left="14dp" android:right="14dp" android:top="34dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="90"
                        android:startColor="#66D9B8FF"
                        android:endColor="#00D9B8FF" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <!-- Shine: white across the upper half -->
            <item android:left="3dp" android:right="3dp" android:top="2dp" android:bottom="26dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#8CFFFFFF"
                        android:endColor="#0AFFFFFF" />
                    <corners
                        android:topLeftRadius="24dp"
                        android:topRightRadius="24dp"
                        android:bottomLeftRadius="14dp"
                        android:bottomRightRadius="14dp" />
                </shape>
            </item>
            <!-- Sparkle: a small bright highlight near the top left -->
            <item android:left="22dp" android:top="6dp" android:width="34dp" android:height="7dp">
                <shape android:shape="oval">
                    <solid android:color="#CCFFFFFF" />
                </shape>
            </item>
            <!-- Thin bright rim -->
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="1dp" android:color="#80E6D2FF" />
                    <corners android:radius="26dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>

<?xml version="1.0" encoding="utf-8"?>
<!-- "I have read today" button: outlined before, header gradient once read. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <!-- Same colours as the header: magenta on the left fading to deep violet. -->
            <gradient
                android:angle="0"
                android:startColor="#8E24AA"
                android:endColor="#5E35B1" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F8F2FB" />
            <stroke android:width="1.5dp" android:color="#CE93D8" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>

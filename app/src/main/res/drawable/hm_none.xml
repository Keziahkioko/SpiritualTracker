<?xml version="1.0" encoding="utf-8"?>
<!-- This week, missed or still to come: a dark glossy chip. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#4A4553" android:endColor="#2A2631" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:top="1dp" android:left="2dp" android:right="2dp" android:bottom="16dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#33FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="8dp" android:topRightRadius="8dp" android:bottomLeftRadius="12dp" android:bottomRightRadius="12dp" />
        </shape>
    </item>
    <item android:top="6dp" android:left="7dp" android:width="10dp" android:height="4dp">
        <shape android:shape="oval">
            <solid android:color="#59FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#4DC9A0FF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<!-- Dashboard tiles, "Obsidian glow": the original charcoal made glossy, with purple light rising
     from the bottom, a lavender rim, a shine and a sparkle, on a near-black side for thickness.
     Pressed, the face sinks towards its side. (card_royal_bg.xml keeps the purple version.) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <!-- The tile's side, showing below the face: near-black, gives it thickness -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#0E0C12" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <!-- The face: charcoal, lit from above -->
            <item android:top="4dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#4C4754" android:endColor="#25212B" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <!-- Purple light rising from the bottom of the face -->
            <item android:top="4dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:type="radial"
                        android:centerX="0.5"
                        android:centerY="1.15"
                        android:gradientRadius="120dp"
                        android:startColor="#B3A23FB5"
                        android:centerColor="#407E45C4"
                        android:endColor="#007E45C4" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <!-- Shine over the upper half -->
            <item android:top="6dp" android:left="2dp" android:right="2dp" android:bottom="72dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#33FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:topLeftRadius="14dp" android:topRightRadius="14dp"
                        android:bottomLeftRadius="40dp" android:bottomRightRadius="40dp" />
                </shape>
            </item>
            <!-- Sparkle near the top left -->
            <item android:top="11dp" android:left="18dp" android:width="42dp" android:height="6dp">
                <shape android:shape="oval">
                    <solid android:color="#8CFFFFFF" />
                </shape>
            </item>
            <!-- Lavender rim light around the face -->
            <item android:top="4dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <stroke android:width="1dp" android:color="#73C9A0FF" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <!-- The tile's side, showing below the face: near-black, gives it thickness -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#0E0C12" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <!-- The face: charcoal, lit from above -->
            <item android:top="0dp" android:bottom="6dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#4C4754" android:endColor="#25212B" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <!-- Purple light rising from the bottom of the face -->
            <item android:top="0dp" android:bottom="6dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:type="radial"
                        android:centerX="0.5"
                        android:centerY="1.15"
                        android:gradientRadius="120dp"
                        android:startColor="#B3A23FB5"
                        android:centerColor="#407E45C4"
                        android:endColor="#007E45C4" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <!-- Shine over the upper half -->
            <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="72dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#33FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:topLeftRadius="14dp" android:topRightRadius="14dp"
                        android:bottomLeftRadius="40dp" android:bottomRightRadius="40dp" />
                </shape>
            </item>
            <!-- Sparkle near the top left -->
            <item android:top="7dp" android:left="18dp" android:width="42dp" android:height="6dp">
                <shape android:shape="oval">
                    <solid android:color="#8CFFFFFF" />
                </shape>
            </item>
            <!-- Lavender rim light around the face -->
            <item android:top="0dp" android:bottom="6dp">
                <shape android:shape="rectangle">
                    <stroke android:width="1dp" android:color="#73C9A0FF" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>

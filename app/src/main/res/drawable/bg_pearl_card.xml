<?xml version="1.0" encoding="utf-8"?>
<!-- Dashboard cards (Today's progress, This week) in the Pearl look, to match the tiles: a soft
     lilac edge below for depth, a pearl face with a faint lavender-to-sky sheen, a shine along the
     top and a white rim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Lilac edge showing below the face -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#D6C8EE" android:endColor="#E7CFE8" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Pearl face -->
    <item android:bottom="5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#FFFFFF"
                android:centerColor="#EFE6FF"
                android:endColor="#E3F1FF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- A faint blush in the bottom right -->
    <item android:bottom="5dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="1.0"
                android:centerY="1.0"
                android:gradientRadius="180dp"
                android:startColor="#80FBE3F2"
                android:endColor="#00FBE6F3" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Shine along the top -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:height="44dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#F2FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="22dp" android:topRightRadius="22dp" />
        </shape>
    </item>
    <!-- White rim -->
    <item android:bottom="5dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#FFFFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>

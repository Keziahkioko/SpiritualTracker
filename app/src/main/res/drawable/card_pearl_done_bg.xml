<?xml version="1.0" encoding="utf-8"?>
<!-- Dashboard tile for a practice done today, light look: the Pearl tile lit up (lavender bloom, lavender rim): airy white with a soft rainbow sheen (lavender, sky blue, blush),
     a shine, a sparkle and a white rim, on a soft lilac side for thickness; purple icons and labels.
     Pressed, the face sinks towards its side. (card_obsidian_bg.xml and card_royal_bg.xml keep the
     Obsidian glow and purple versions.) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <!-- The tile's side, showing below the face: soft lilac, gives it thickness -->
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#D6C8EE" android:endColor="#E7CFE8" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <!-- The face: pearl white with a soft rainbow sheen -->
            <item android:top="4dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="315"
                        android:startColor="#FFFFFF"
                        android:centerColor="#EFE6FF"
                        android:endColor="#E3F1FF" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <!-- A blush of pink from the bottom right -->
            <item android:top="4dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:type="radial"
                        android:centerX="1.0"
                        android:centerY="1.0"
                        android:gradientRadius="120dp"
                        android:startColor="#B3E9D5FF"
                        android:endColor="#00FBE3F2" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <!-- Shine over the upper half -->
            <item android:top="6dp" android:left="2dp" android:right="2dp" android:bottom="72dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#E6FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:topLeftRadius="14dp" android:topRightRadius="14dp"
                        android:bottomLeftRadius="40dp" android:bottomRightRadius="40dp" />
                </shape>
            </item>
            <!-- Sparkle near the top left -->
            <item android:top="11dp" android:left="18dp" android:width="42dp" android:height="6dp">
                <shape android:shape="oval">
                    <solid android:color="#FFFFFFFF" />
                </shape>
            </item>
            <!-- White rim around the face -->
            <item android:top="4dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <stroke android:width="2dp" android:color="#C9A6F5" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <!-- The tile's side, showing below the face: soft lilac, gives it thickness -->
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#D6C8EE" android:endColor="#E7CFE8" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <!-- The face: pearl white with a soft rainbow sheen -->
            <item android:top="0dp" android:bottom="6dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="315"
                        android:startColor="#FFFFFF"
                        android:centerColor="#EFE6FF"
                        android:endColor="#E3F1FF" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <!-- A blush of pink from the bottom right -->
            <item android:top="0dp" android:bottom="6dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:type="radial"
                        android:centerX="1.0"
                        android:centerY="1.0"
                        android:gradientRadius="120dp"
                        android:startColor="#B3E9D5FF"
                        android:endColor="#00FBE3F2" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <!-- Shine over the upper half -->
            <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="72dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#E6FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:topLeftRadius="14dp" android:topRightRadius="14dp"
                        android:bottomLeftRadius="40dp" android:bottomRightRadius="40dp" />
                </shape>
            </item>
            <!-- Sparkle near the top left -->
            <item android:top="7dp" android:left="18dp" android:width="42dp" android:height="6dp">
                <shape android:shape="oval">
                    <solid android:color="#FFFFFFFF" />
                </shape>
            </item>
            <!-- White rim around the face -->
            <item android:top="0dp" android:bottom="6dp">
                <shape android:shape="rectangle">
                    <stroke android:width="2dp" android:color="#C9A6F5" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>

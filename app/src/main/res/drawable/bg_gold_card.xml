<?xml version="1.0" encoding="utf-8"?>
<!-- "You both finished today": a glossy gold card, a deeper amber edge below for depth, a white
     shine along the top, a small sparkle and a bright rim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#B8741A" android:endColor="#A5621A" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:bottom="5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#F9DD7E"
                android:centerColor="#F4BE4C"
                android:endColor="#EBA034" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:bottom="5dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#00000000" android:endColor="#33A0560F" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:top="2dp" android:left="3dp" android:right="3dp" android:height="30dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#B3FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="20dp" android:topRightRadius="20dp" />
        </shape>
    </item>
    <item android:top="7dp" android:left="24dp" android:width="46dp" android:height="6dp">
        <shape android:shape="oval">
            <solid android:color="#CCFFFFFF" />
        </shape>
    </item>
    <item android:bottom="5dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#CCFFF3C4" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>

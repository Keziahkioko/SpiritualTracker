<?xml version="1.0" encoding="utf-8"?>
<!-- Today's progress, done: a glossy violet bead. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="#A47BEA" android:endColor="#6A3CC8" />
        </shape>
    </item>
    <!-- Shine over the upper half -->
    <item android:top="1dp" android:left="2dp" android:right="2dp" android:bottom="12dp">
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="#99FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <!-- Rim -->
    <item>
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#66E6D2FF" />
        </shape>
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<!-- Listen controls for a verse; wired up by VerseSpeaker.bind(). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnListen"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:textAllCaps="false"
            android:textColor="@color/st_accent_strong"
            android:textSize="13sp"
            android:letterSpacing="0"
            app:backgroundTint="@color/st_soft"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_listen"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="18dp"
            app:iconTint="@null" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEcho"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.35"
            android:layout_marginStart="5dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:textAllCaps="false"
            android:textColor="@color/st_accent_strong"
            android:textSize="13sp"
            android:letterSpacing="0"
            app:backgroundTint="@color/st_soft"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_repeat_after"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="18dp"
            app:iconTint="@null" />
    </LinearLayout>

    <!-- While playing: the round, and in Repeat after me the phrase to say back -->
    <TextView
        android:id="@+id/tvListenStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_learn_text"
        android:gravity="center"
        android:lineSpacingMultiplier="1.2"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        android:textColor="@color/st_text"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Speed and how many times: compact pills, tap to change -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/progress_pill_bg"
            android:foreground="?attr/selectableItemBackground"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:textColor="@color/st_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTimes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/progress_pill_bg"
            android:foreground="?attr/selectableItemBackground"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:textColor="@color/st_accent"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>

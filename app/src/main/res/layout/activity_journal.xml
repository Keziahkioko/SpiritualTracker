<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/st_page"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="28dp">

            <ImageView
                android:id="@+id/btnJournalClose"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="-10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close"
                android:padding="10dp"
                android:src="@drawable/ic_back"
                app:tint="@color/st_text" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvJournalHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="New Journal Entry"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:textColor="@color/st_text"/>

                <TextView
                    android:id="@+id/tvJournalDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Today"
                    android:textSize="13sp"
                    android:textColor="@color/st_accent"/>
            </LinearLayout>
        </FrameLayout>

        <EditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_journal_field"
            android:elevation="1dp"
            android:padding="18dp"
            android:hint="Title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:layout_marginBottom="16dp"
            android:layout_marginHorizontal="2dp"
            android:textColor="@color/st_text"
            android:textColorHint="@color/st_text_3"/>

        <EditText
            android:id="@+id/etContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_journal_field"
            android:elevation="1dp"
            android:padding="18dp"
            android:hint="Write your thoughts here..."
            android:gravity="top|start"
            android:textSize="16sp"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="14dp"
            android:layout_marginHorizontal="2dp"
            android:textColor="@color/st_text"
            android:textColorHint="@color/st_text_3"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical|end"
            android:layout_marginBottom="20dp">

            <!-- Photos of handwritten notes etc.: "Add photo" tile, then the chosen photos. -->
            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:clipToPadding="false"
                android:paddingTop="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/photoStrip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/btnAddPhoto"
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:background="@drawable/bg_add_photo_tile"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_add_photo" />

                        <TextView
                            android:id="@+id/tvAddPhoto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Add photo"
                            android:textColor="@color/st_accent"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/tvRecordTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:text="00:00"
                android:textColor="@color/st_text_2"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="4dp"
                android:visibility="gone" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnDiscardAudio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_st_trash"
                app:backgroundTint="@color/st_danger_soft"
                app:tint="@color/st_danger"
                app:elevation="0dp"
                app:fabCustomSize="40dp"
                android:visibility="gone" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnRecord"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_st_mic"
                app:backgroundTint="@color/st_accent_fill"
                app:tint="@android:color/white"
                app:elevation="2dp"
                app:fabSize="normal" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveJournal"
            style="@style/Widget.ST.GlossyButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Save Entry"
            android:textSize="17sp"
            android:outlineSpotShadowColor="#8E44C9"
            android:outlineAmbientShadowColor="#8E44C9"/>

    </LinearLayout>
</LinearLayout>
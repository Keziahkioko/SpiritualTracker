<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Reference + Day progress pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvQuizReference"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#1A1A2E"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="serif"/>

        <TextView
            android:id="@+id/tvQuizProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/progress_pill_bg"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="#7E57C2"
            android:textSize="11sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:maxHeight="300dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Prompt -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Can you recall this verse?"
                android:textColor="#5F5F64"
                android:textSize="13sp"
                android:layout_marginBottom="12dp"/>

            <!-- Hint with gaps or first-letter tiles (Day 3+, or "Show first letters"); tap one to peek -->
            <TextView
                android:id="@+id/tvQuizHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_learn_text"
                android:padding="16dp"
                android:textColor="#1A1A2E"
                android:textSize="16sp"
                android:fontFamily="serif"
                android:lineSpacingMultiplier="1.5"
                android:layout_marginBottom="12dp"
                android:visibility="gone"/>

            <!-- Revealed full text -->
            <TextView
                android:id="@+id/tvQuizText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#1A1A2E"
                android:textSize="16sp"
                android:fontFamily="serif"
                android:lineSpacingMultiplier="1.5"
                android:layout_marginBottom="12dp"
                android:visibility="gone"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- First-letter hint -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFirstLetter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Show first letters"
        android:textAllCaps="false"
        android:letterSpacing="0"
        android:textSize="13sp"
        android:textColor="#5E35B1"
        android:layout_marginBottom="8dp"
        app:strokeColor="#9575CD"
        app:strokeWidth="1dp"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        app:cornerRadius="20dp"/>

    <!-- Day 1 only: do the learn steps instead of being tested on something not learned yet -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLearnFirst"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="Not learned yet? Learn it first"
        android:letterSpacing="0"
        android:textAllCaps="false"
        android:textColor="#5E35B1"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Reveal -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnReveal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reveal verse"
        android:textColor="#FFFFFF"
        app:backgroundTint="#7E57C2"
        app:cornerRadius="12dp"/>

    <!-- Listen: only after Reveal, so it never gives the answer away -->
    <include
        android:id="@+id/quizListen"
        layout="@layout/view_listen_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <!-- After Reveal: how many words were peeked at, to help mark yourself honestly -->
    <TextView
        android:id="@+id/tvQuizPeeks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_horizontal"
        android:textColor="#6A4FB0"
        android:textSize="13sp"
        android:visibility="gone"/>

    <!-- Got it / Try again -->
    <LinearLayout
        android:id="@+id/layoutQuizActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTryAgain"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Try again"
            android:textAllCaps="false"
            android:letterSpacing="0"
            app:strokeColor="#B39DDB"
            app:strokeWidth="1dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:cornerRadius="12dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGotIt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Got it! ✓"
            android:textColor="#FFFFFF"
            app:backgroundTint="#4CAF50"
            app:cornerRadius="12dp"/>
    </LinearLayout>

</LinearLayout>

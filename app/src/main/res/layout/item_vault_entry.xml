<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="10dp"
    android:layout_marginStart="2dp"
    android:layout_marginEnd="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/vault_card_bg"
        android:elevation="2dp">

        <!-- Card body -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="0dp"
            android:gravity="top">

            <!-- Row number -->
            <TextView
                android:id="@+id/tvRowNumber"
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#C5BFEA"
                android:layout_marginTop="2dp"
                android:text="01" />

            <!-- Body -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRequestTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A2E"
                    android:lineSpacingMultiplier="1.3"
                    android:layout_marginBottom="3dp" />

                <TextView
                    android:id="@+id/tvRequestMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="#AAAAAA"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvRequestDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#555555"
                    android:lineSpacingMultiplier="1.55"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:layout_marginBottom="12dp" />

            </LinearLayout>
        </LinearLayout>

        <!-- Divider between description and ANSWERED pill -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="#EDE7F6"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <!-- ANSWERED pill row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/answered_pill_bg"
                android:paddingStart="8dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓"
                    android:textColor="#5E35B1"
                    android:textSize="10sp"
                    android:layout_marginEnd="5dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ANSWERED"
                    android:textColor="#5E35B1"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
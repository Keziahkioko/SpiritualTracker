<?xml version="1.0" encoding="utf-8"?>
<!-- A testimony card: the prayer, God's answer as a quote, then who prayed it and when. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="2dp"
    android:layout_marginEnd="2dp"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeColor="#EDE7F6"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/tvRequestTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:lineSpacingMultiplier="1.15"
            android:textColor="#1A1A2E"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- God's answer, shown when a testimony was written -->
        <LinearLayout
            android:id="@+id/layoutTestimony"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_vault_quote"
            android:orientation="horizontal"
            android:padding="12dp">

            <View
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="10dp"
                android:background="#9575CD" />

            <TextView
                android:id="@+id/tvTestimonyPreview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:lineSpacingMultiplier="1.3"
                android:maxLines="3"
                android:textColor="#4A148C"
                android:textSize="14sp"
                android:textStyle="italic" />
        </LinearLayout>

        <!-- Original request, shown when there's no testimony -->
        <TextView
            android:id="@+id/tvRequestDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.4"
            android:maxLines="2"
            android:textColor="#616161"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvRequestMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#6A4FB0"
            android:textSize="12sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

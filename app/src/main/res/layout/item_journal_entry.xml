<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="2dp"
    android:layout_marginEnd="2dp"
    android:layout_marginBottom="12dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:strokeColor="#EDE7F6"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

    <!-- Purple for my entries, green for my partner's -->
    <View
        android:id="@+id/viewJournalStripe"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="#7E57C2"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Row 1: Title + time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:textColor="#1A1A2E"
                android:lineSpacingMultiplier="1.15"
                android:layout_marginEnd="10dp"
                tools:text="Eye witnesses of His majesty"/>

            <!-- Time now shares the date line below -->
            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"/>

        </LinearLayout>

        <!-- Row 2: Date + author pill + status pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:textColor="#6A4FB0"
                tools:text="Apr 18, 2026  ·  6:22 AM"/>

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/pill_draft"
                android:textColor="#A65300"
                android:visibility="gone"
                tools:text="Draft"
                tools:visibility="visible"/>

            <TextView
                android:id="@+id/tvAuthor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:background="@drawable/pill_me"
                android:textColor="#5B21B6"
                tools:text="Me"/>

            <TextView
                android:id="@+id/tvUnreadBadge"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_circle_purple"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="2"
                tools:visibility="visible"/>

        </LinearLayout>

        <!-- Text preview (shown when no audio, hidden when audio entry) -->
        <TextView
            android:id="@+id/tvPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#4A4A4E"
            android:lineSpacingMultiplier="1.4"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone"
            tools:text="In Matthew 17:1–13, I see something incredible. The transfiguration reveals who Jesus really is..."
            tools:visibility="visible"/>

        <!-- Audio footer (shown only when audio entry) -->
        <LinearLayout
            android:id="@+id/layoutAudioFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Play pill -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_audio_pill"
                android:paddingStart="6dp"
                android:paddingEnd="12dp">

                <ImageButton
                    android:id="@+id/btnPlayAudio"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_media_play"
                    android:background="@drawable/circle_background"
                    android:backgroundTint="#7E57C2"
                    android:padding="5dp"
                    android:layout_marginEnd="8dp"
                    app:tint="#FFFFFF" />

                <!-- Mini waveform bars (decorative) -->
                <View android:layout_width="2dp" android:layout_height="6dp"  android:background="#D8B4FE" android:layout_marginEnd="2dp"/>
                <View android:layout_width="2dp" android:layout_height="12dp" android:background="#D8B4FE" android:layout_marginEnd="2dp"/>
                <View android:layout_width="2dp" android:layout_height="8dp"  android:background="#D8B4FE" android:layout_marginEnd="2dp"/>
                <View android:layout_width="2dp" android:layout_height="16dp" android:background="#D8B4FE" android:layout_marginEnd="2dp"/>
                <View android:layout_width="2dp" android:layout_height="6dp"  android:background="#D8B4FE" android:layout_marginEnd="2dp"/>
                <View android:layout_width="2dp" android:layout_height="10dp" android:background="#D8B4FE" android:layout_marginEnd="2dp"/>
                <View android:layout_width="2dp" android:layout_height="4dp"  android:background="#D8B4FE" android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/tvAudioDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="#7E57C2"
                    tools:text="0:42"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- First photo of the entry, with "+n" when there are more. -->
    <FrameLayout
        android:id="@+id/photoThumbBox"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="14dp"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivPhotoThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            app:shapeAppearance="@style/PhotoThumbShape" />

        <TextView
            android:id="@+id/tvPhotoCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="4dp"
            android:background="@drawable/bg_photo_close"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="+2"
            tools:visibility="visible" />
    </FrameLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#EBEBEB"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Row 1: Title + time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1A1A2E"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginEnd="10dp"
                tools:text="Eye witnesses of His majesty"/>

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#AAAAAA"
                android:layout_marginTop="2dp"
                tools:text="06:22"/>

        </LinearLayout>

        <!-- Row 2: Date + author pill + status pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11sp"
                android:textColor="#AAAAAA"
                tools:text="Apr 18, 2026"/>

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/pill_draft"
                android:textColor="#BF6000"
                android:visibility="gone"
                tools:text="Draft"
                tools:visibility="visible"/>

            <TextView
                android:id="@+id/tvAuthor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:background="@drawable/pill_me"
                android:textColor="#5B21B6"
                tools:text="Me"/>

            <TextView
                android:id="@+id/tvUnreadBadge"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_circle_purple"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="2"
                tools:visibility="visible"/>

        </LinearLayout>

        <!-- Text preview (shown when no audio, hidden when audio entry) -->
        <TextView
            android:id="@+id/tvPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#666666"
            android:lineSpacingMultiplier="1.5"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone"
            tools:text="In Matthew 17:1–13, I see something incredible. The transfiguration reveals who Jesus really is..."
            tools:visibility="visible"/>

        <!-- Audio footer (shown only when audio entry) -->
        <LinearLayout
            android:id="@+id/layoutAudioFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Play pill -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_audio_pill"
                android:paddingStart="6dp"
                android:paddingEnd="12dp">

                <ImageButton
                    android:id="@+id/btnPlayAudio"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_media_play"
                    android:background="@drawable/circle_background"
                    android:backgroundTint="#7C3AED"
                    android:padding="5dp"
                    android:layout_marginEnd="8dp"
                    app:tint="#FFFFFF" />

                <!-- Mini waveform bars (decorative) -->
                <View android:layout_width="2dp" android:layout_height="6dp"  android:background="#D8B4FE" android:layout_marginEnd="2dp"/>
                <View android:layout_width="2dp" android:layout_height="12dp" android:background="#D8B4FE" android:layout_marginEnd="2dp"/>
                <View android:layout_width="2dp" android:layout_height="8dp"  android:background="#D8B4FE" android:layout_marginEnd="2dp"/>
                <View android:layout_width="2dp" android:layout_height="16dp" android:background="#D8B4FE" android:layout_marginEnd="2dp"/>
                <View android:layout_width="2dp" android:layout_height="6dp"  android:background="#D8B4FE" android:layout_marginEnd="2dp"/>
                <View android:layout_width="2dp" android:layout_height="10dp" android:background="#D8B4FE" android:layout_marginEnd="2dp"/>
                <View android:layout_width="2dp" android:layout_height="4dp"  android:background="#D8B4FE" android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/tvAudioDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="#7C3AED"
                    tools:text="0:42"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>

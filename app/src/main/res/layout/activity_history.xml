<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F5FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/historyHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_gradient"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="22dp">

            <ImageView
                android:id="@+id/btnHistoryBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="-10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:padding="10dp"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:letterSpacing="0.15"
                android:text="HISTORY"
                android:textColor="#EDE7F6"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="serif"
                android:text="Our Journey"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHistorySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Every day you have shown up"
                android:textColor="#EDE7F6"
                android:textSize="13sp" />

            <!-- Me / Partner / Us toggle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_tab_group"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/tabHistoryMe"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/tab_active"
                    android:gravity="center"
                    android:text="Me"
                    android:textColor="#4527A0"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabHistoryPartner"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Partner"
                    android:textColor="#5F5F64" />

                <TextView
                    android:id="@+id/tabHistoryUs"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Us"
                    android:textColor="#5F5F64" />
            </LinearLayout>
        </LinearLayout>

        <!-- Me / Partner: that person's week so far (Monday to today), one ring per practice. -->
        <LinearLayout
            android:id="@+id/personRings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/HistorySectionTitle"
                android:text="THIS WEEK" />

            <LinearLayout
                android:id="@+id/personRingsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_history_card"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="16dp"
                android:paddingEnd="8dp"
                android:paddingBottom="14dp" />
        </LinearLayout>

        <!-- Month navigation -->
        <LinearLayout
            android:id="@+id/monthNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnPrevMonth"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Previous month"
                android:gravity="center"
                android:text="‹"
                android:textColor="#5E35B1"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/tvMonthTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="October 2026"
                android:textColor="#1A1A2E"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnNextMonth"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Next month"
                android:gravity="center"
                android:text="›"
                android:textColor="#5E35B1"
                android:textSize="28sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp" />

        <LinearLayout
            android:id="@+id/historyContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- ── Me / Partner: one person's month ── -->
            <LinearLayout
                android:id="@+id/personContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <!-- Month summary -->
            <LinearLayout
                android:id="@+id/monthSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_history_card"
                android:orientation="horizontal"
                android:padding="12dp" />

            <!-- Calendar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_history_card"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:id="@+id/weekdayHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

                <GridLayout
                    android:id="@+id/calendarGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:columnCount="7" />

                <LinearLayout
                    android:id="@+id/calendarLegend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Tap a day to see what was read, prayed, written and memorized"
                    android:textColor="#5F5F64"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Streaks -->
            <TextView
                style="@style/HistorySectionTitle"
                android:text="STREAKS" />

            <LinearLayout
                android:id="@+id/streakContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_history_card"
                android:orientation="vertical"
                android:padding="14dp" />

            <TextView
                style="@style/HistorySectionTitle"
                android:text="OVER TIME" />

            <LinearLayout
                android:id="@+id/personTrendContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_history_card"
                android:orientation="vertical"
                android:padding="14dp" />
            </LinearLayout>

            <!-- ── Us: both partners together, no calendar ── -->
            <LinearLayout
                android:id="@+id/usContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

            <!-- This week (Monday to today): one paired ring per practice (outer me, inner partner). -->
            <TextView
                style="@style/HistorySectionTitle"
                android:text="THIS WEEK" />

            <LinearLayout
                android:id="@+id/ringsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_history_card"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingTop="16dp"
                android:paddingEnd="8dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:id="@+id/ringsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:id="@+id/ringsLegend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal" />
            </LinearLayout>

            <TextView
                style="@style/HistorySectionTitle"
                android:text="STREAKS" />

            <LinearLayout
                android:id="@+id/usStreakContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_history_card"
                android:orientation="vertical"
                android:padding="14dp" />

            <TextView
                style="@style/HistorySectionTitle"
                android:text="OVER TIME" />

            <LinearLayout
                android:id="@+id/trendContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_history_card"
                android:orientation="vertical"
                android:padding="14dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>

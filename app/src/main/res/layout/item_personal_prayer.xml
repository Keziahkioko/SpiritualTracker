<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

<!-- Shown above the first answered prayer only -->
<TextView
    android:id="@+id/tvAnsweredSection"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginTop="14dp"
    android:layout_marginBottom="10dp"
    android:letterSpacing="0.1"
    android:text="ANSWERED"
    android:textColor="@color/st_accent"
    android:textSize="12sp"
    android:textStyle="bold"
    android:visibility="gone" />

<com.google.android.material.card.MaterialCardView
    android:id="@+id/cardPersonal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@android:color/transparent"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="3dp"
        android:clipToOutline="true"
        android:background="@drawable/bg_card_small">

        <!-- Accent stripe: purple by default, dimmed if answered -->
        <com.keziah.spiritualtracker.BendStripe
            android:id="@+id/viewAccentStripe"
            android:layout_width="22dp"
            android:layout_height="match_parent"
            android:background="#7E57C2"
            android:layout_marginEnd="-18dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Title + answered badge -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tvPersonalTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@+id/personalAnsweredBadge"
                    android:layout_marginEnd="8dp"
                    android:layout_centerVertical="true"
                    android:text="My Prayer"
                    android:textColor="@color/st_text"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"/>

                <!-- Answered pill (hidden while active) -->
                <LinearLayout
                    android:id="@+id/personalAnsweredBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_answered_pill"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="visible">

                    <TextView
                        android:id="@+id/tvPersonalAnsweredLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mark answered"
                        android:textColor="@color/st_accent"
                        android:textSize="11sp"
                        android:textStyle="bold"/>

                    <ImageView
                        android:id="@+id/ivPersonalAnsweredIcon"
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_partner_done"
                        app:tint="@color/st_accent"/>
                </LinearLayout>
            </RelativeLayout>

            <!-- God's answer, shown on answered prayers -->
            <LinearLayout
                android:id="@+id/layoutPersonalTestimony"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_vault_quote"
                android:orientation="horizontal"
                android:padding="12dp"
                android:visibility="gone">

                <View
                    android:layout_width="3dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="10dp"
                    android:background="#9575CD" />

                <TextView
                    android:id="@+id/tvPersonalTestimony"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="serif"
                    android:lineSpacingMultiplier="1.3"
                    android:maxLines="3"
                    android:textColor="@color/st_accent_strong"
                    android:textSize="14sp"
                    android:textStyle="italic" />
            </LinearLayout>

            <!-- Description -->
            <TextView
                android:id="@+id/tvPersonalDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Details..."
                android:textColor="@color/st_text_2"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginBottom="10dp"/>

            <!-- Date, then the weekly reminder: which day, and a bell to switch it on or off -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPersonalDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Added Apr 08, 2026"
                    android:textColor="@color/st_text_2"
                    android:textSize="11sp"/>

                <TextView
                    android:id="@+id/personalReminderDay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/st_accent"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingVertical="6dp"
                    android:paddingStart="8dp"
                    android:visibility="gone"/>

                <ImageView
                    android:id="@+id/personalReminderBell"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="6dp"
                    android:layout_marginEnd="-6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_bell_on"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F3FF">

    <!-- HEADER -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F4F3FF"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="52dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/tvGhostNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="-8dp"
            android:text="0"
            android:textColor="#1A1A2E"
            android:alpha="0.05"
            android:textSize="120sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:includeFontPadding="false" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRAYER VAULT"
                android:textColor="#9E8FC4"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Testimonies"
                android:textColor="#1A1A2E"
                android:textSize="34sp"
                android:fontFamily="serif" />

        </LinearLayout>
    </FrameLayout>

    <!-- STATS CHIPS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp"
        android:background="#F4F3FF">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/stat_chip_bg">

            <TextView
                android:id="@+id/tvStatTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#1A1A2E"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOTAL"
                android:textColor="#9E8FC4"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/stat_chip_bg">

            <TextView
                android:id="@+id/tvStatMine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#1A1A2E"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MINE"
                android:textColor="#9E8FC4"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/stat_chip_bg">

            <TextView
                android:id="@+id/tvStatPartner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#1A1A2E"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PARTNER"
                android:textColor="#9E8FC4"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginTop="2dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- TABS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:background="#F4F3FF">

        <TextView
            android:id="@+id/tabAll"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="All"
            android:gravity="center"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1A1A2E"
            android:paddingEnd="0dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/tab_underline_active" />

        <TextView
            android:id="@+id/tabMine"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="Mine"
            android:gravity="center"
            android:textSize="14sp"
            android:textColor="#AAAAAA"
            android:paddingEnd="0dp"
            android:layout_marginEnd="24dp"
            android:background="@android:color/transparent" />

        <TextView
            android:id="@+id/tabPartner"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="Partner"
            android:gravity="center"
            android:textSize="14sp"
            android:textColor="#AAAAAA"
            android:background="@android:color/transparent" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#DDD8F5" />

    <!-- LIST -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvVault"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="32dp"
            android:clipToPadding="false" />

        <LinearLayout
            android:id="@+id/layoutEmptyVault"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingStart="48dp"
            android:paddingEnd="48dp"
            android:paddingBottom="80dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nothing here yet"
                android:textColor="#1A1A2E"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="When God answers your prayers, they will be preserved here as testimonies."
                android:textColor="#9E9E9E"
                android:textSize="13sp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.5" />
        </LinearLayout>

    </FrameLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Purple header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_header"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="28dp"
        android:paddingBottom="24dp"
        android:paddingHorizontal="24dp">

        <!-- Double check icon circle -->
        <LinearLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/circle_background"
            android:backgroundTint="#30FFFFFF"
            android:gravity="center"
            android:layout_marginBottom="14dp">
            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_check_double"
                app:tint="#FFFFFF"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Praise Report!"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/tvDialogRequestTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Prayer title"
            android:textColor="#D1C4E9"
            android:textSize="12sp"
            android:paddingHorizontal="16dp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"/>
    </LinearLayout>

    <!-- Input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#FFFFFF">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="How did God answer this prayer?"
            android:textColor="#4A4A4E"
            android:textSize="13sp"
            android:layout_marginBottom="14dp"/>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Write your testimony..."
            app:boxStrokeColor="#7E57C2"
            app:hintTextColor="#7E57C2">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTestimony"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:minLines="4"
                android:inputType="textMultiLine|textCapSentences"
                android:textSize="15sp"
                android:textColor="#1A1A1A"/>
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</LinearLayout>
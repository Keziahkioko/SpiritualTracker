<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add a Long Passage"
            android:textColor="#1A1A2E"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paste the full passage. The app will split it into chunks and unlock them one by one as you master each part."
            android:textColor="#9E9E9E"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="20dp"/>

        <!-- Book / chapter reference -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Passage reference (e.g. Psalm 23)"
            android:layout_marginBottom="14dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="#7E57C2"
            app:boxStrokeWidth="1.5dp"
            app:boxStrokeWidthFocused="2dp"
            app:hintTextColor="#1A1A2E"
            app:boxBackgroundColor="#F8F5FF"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassageReference"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="#1A1A2E"
                android:textSize="15sp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Full passage text -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Paste the full passage text here"
            android:layout_marginBottom="14dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="#7E57C2"
            app:boxStrokeWidth="1.5dp"
            app:boxStrokeWidthFocused="2dp"
            app:hintTextColor="#1A1A2E"
            app:boxBackgroundColor="#F8F5FF"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassageText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:minLines="6"
                android:gravity="top|start"
                android:textColor="#1A1A2E"
                android:textSize="13sp"
                android:paddingTop="12dp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Chunk size selector -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Verses per chunk"
            android:textColor="#5E35B1"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="18dp">

            <TextView
                android:id="@+id/btnChunk3"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:text="3"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/chunk_btn_selected"/>

            <TextView
                android:id="@+id/btnChunk4"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:text="4"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#7E57C2"
                android:background="@drawable/chunk_btn_unselected"/>

            <TextView
                android:id="@+id/btnChunk5"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="5"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#7E57C2"
                android:background="@drawable/chunk_btn_unselected"/>
        </LinearLayout>

        <!-- Shared toggle -->
        <CheckBox
            android:id="@+id/cbPassageShared"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Share with my partner"
            android:textColor="#5E35B1"
            android:textSize="14sp"
            android:buttonTint="#7E57C2"
            android:visibility="gone"/>

    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@android:color/transparent"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="3dp"
        android:background="@drawable/bg_card_small">

        <!-- Purple left accent stripe -->
        <View
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="#7E57C2"/>

        <!-- Card content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Title row + badge -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tvRequestTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@+id/answeredBadge"
                    android:layout_marginEnd="8dp"
                    android:text="Prayer Title"
                    android:textColor="@color/st_text"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:lineSpacingExtra="2dp"/>

                <!-- Answered pill badge -->
                <LinearLayout
                    android:id="@+id/answeredBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_answered_pill"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/btnMarkAnswered"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mark answered"
                        android:textColor="@color/st_accent"
                        android:textSize="11sp"
                        android:textStyle="bold"/>

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_partner_done"
                        app:tint="@color/st_accent"/>
                </LinearLayout>
            </RelativeLayout>

            <TextView
                android:id="@+id/tvRequestDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Snippet of the prayer request..."
                android:textColor="@color/st_text_2"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginBottom="10dp"/>

            <!-- Date, then the weekly reminder: which day, and a bell to switch it on or off -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvRequestAuthor"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="By Partner · Apr 08, 2026"
                    android:textColor="@color/st_text_2"
                    android:textSize="11sp"/>

                <TextView
                    android:id="@+id/requestReminderDay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/st_accent"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingVertical="6dp"
                    android:paddingStart="8dp"
                    android:visibility="gone"/>

                <ImageView
                    android:id="@+id/requestReminderBell"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="6dp"
                    android:layout_marginEnd="-6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_bell_on"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F4F9"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/layoutTopCards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:padding="8dp"
        android:weightSum="2">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#D1C4E9"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My Status"
                    android:textColor="#7E57C2"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <CheckBox
                    android:id="@+id/cbMyPrayedToday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prayed Today"
                    android:textColor="#424242"
                    android:textSize="12sp"
                    android:buttonTint="#7E57C2" />

                <CheckBox
                    android:id="@+id/cbMyPrayedPartner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prayed for Partner"
                    android:textColor="#424242"
                    android:textSize="12sp"
                    android:buttonTint="#7E57C2" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#D1C4E9"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="12dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/tvPartnerNameStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="Partner"
                        android:textColor="#7E57C2"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:id="@+id/btnNudgePartner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_nudge"
                            android:scaleType="fitCenter" />
                    </FrameLayout>
                </RelativeLayout>

                <CheckBox
                    android:id="@+id/cbPartnerPrayedToday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prayed Today"
                    android:textColor="#424242"
                    android:textSize="12sp"
                    android:clickable="false"
                    android:buttonTint="@color/partner_checkbox_tint" />

                <CheckBox
                    android:id="@+id/cbPartnerPrayedPartner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prayed for Partner"
                    android:textColor="#424242"
                    android:textSize="12sp"
                    android:clickable="false"
                    android:buttonTint="@color/partner_checkbox_tint" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvConnectionFeed"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/layoutConnectionBar"
        android:layout_below="@id/layoutTopCards"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:id="@+id/layoutConnectionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FAFAFA"
        android:elevation="12dp"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_chat_input"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/layoutMessagePreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F5F5F5"
                android:orientation="horizontal"
                android:padding="8dp"
                android:visibility="gone">

                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:background="#7E57C2" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="8dp">

                    <TextView
                        android:id="@+id/tvMessagePreviewName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Partner"
                        android:textColor="#7E57C2"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMessagePreviewText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#555555"
                        android:textSize="14sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnClosePreview"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="?selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="#9E9E9E" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp">

                <TextView
                    android:id="@+id/tvTypingIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginBottom="4dp"
                    android:text="Partner is typing..."
                    android:textColor="#7E57C2"
                    android:textSize="13sp"
                    android:textStyle="italic"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/etMessageInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="Share a prayer..."
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="5"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="12dp"
                    android:textColor="#1A1A1A"
                    android:textColorHint="#9E9E9E"
                    android:textSize="16sp" />

                <LinearLayout
                    android:id="@+id/layoutRecordingUI"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp"
                    android:visibility="gone">

                    <ImageButton
                        android:id="@+id/btnDiscardAudio"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center_vertical"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_delete"
                        app:tint="#E53935" />

                    <TextView
                        android:id="@+id/tvRecordTimer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="00:00"
                        android:textColor="#7E57C2"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnSendAudio"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/circle_background"
                        android:backgroundTint="#7E57C2"
                        android:src="@android:drawable/ic_menu_send"
                        app:tint="#FFFFFF" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnSendOrRecord"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="2dp"
            android:src="@android:drawable/ic_btn_speak_now"
            app:backgroundTint="#7E57C2"
            app:borderWidth="0dp"
            app:elevation="2dp"
            app:fabCustomSize="48dp"
            app:tint="#FFFFFF" />

    </LinearLayout>

</RelativeLayout>
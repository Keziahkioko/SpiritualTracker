<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/st_page">

    <!-- Slim header matching the Board and My Space tabs -->
    <LinearLayout
        android:id="@+id/connectionHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@drawable/bg_header_gradient"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:letterSpacing="0.15"
            android:text="CONNECTION"
            android:textColor="#EDE7F6"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvConnectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="Praying together"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutTopCards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/connectionHeader"
        android:orientation="horizontal"
        android:padding="8dp"
        android:weightSum="2">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="18dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="15dp"
                android:background="@drawable/bg_card_small">

                <!-- Same height as the partner card's header (name + nudge bell), so the
                     checkboxes in both cards line up. -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center_vertical"
                    android:text="My Status"
                    android:textColor="@color/st_accent"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <CheckBox
                    android:id="@+id/cbMyPrayedToday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prayed Today"
                    android:textColor="@color/st_text"
                    android:textSize="12sp"
                    android:button="@drawable/cb_mine"
                    android:paddingStart="8dp"
                    app:buttonTint="@null"
                    app:useMaterialThemeColors="false" />

                <CheckBox
                    android:id="@+id/cbMyPrayedPartner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prayed for Partner"
                    android:textColor="@color/st_text"
                    android:textSize="12sp"
                    android:button="@drawable/cb_mine"
                    android:paddingStart="8dp"
                    app:buttonTint="@null"
                    app:useMaterialThemeColors="false" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="18dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="15dp"
                android:background="@drawable/bg_card_small">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/tvPartnerNameStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="Partner"
                        android:textColor="@color/st_accent"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:id="@+id/btnNudgePartner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_nudge"
                            android:scaleType="fitCenter" />
                    </FrameLayout>
                </RelativeLayout>

                <CheckBox
                    android:id="@+id/cbPartnerPrayedToday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prayed Today"
                    android:textColor="@color/st_text"
                    android:textSize="12sp"
                    android:clickable="false"
                    android:button="@drawable/cb_partner"
                    android:paddingStart="8dp"
                    app:buttonTint="@null"
                    app:useMaterialThemeColors="false" />

                <CheckBox
                    android:id="@+id/cbPartnerPrayedPartner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prayed for me"
                    android:textColor="@color/st_text"
                    android:textSize="12sp"
                    android:clickable="false"
                    android:button="@drawable/cb_partner"
                    android:paddingStart="8dp"
                    app:buttonTint="@null"
                    app:useMaterialThemeColors="false" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvConnectionFeed"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/layoutConnectionBar"
        android:layout_below="@id/layoutTopCards"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:id="@+id/layoutConnectionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/st_surface_alt"
        android:elevation="12dp"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_chat_input"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/layoutMessagePreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/st_page"
                android:orientation="horizontal"
                android:padding="8dp"
                android:visibility="gone">

                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:background="#7E57C2" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="8dp"
                    app:buttonTint="@null"
                    app:useMaterialThemeColors="false">

                    <TextView
                        android:id="@+id/tvMessagePreviewName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Partner"
                        android:textColor="@color/st_accent"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMessagePreviewText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/st_text_2"
                        android:textSize="14sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnClosePreview"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="?selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_st_close"
                    app:tint="@color/st_text_3" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp">

                <TextView
                    android:id="@+id/tvTypingIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginBottom="4dp"
                    android:text="Partner is typing..."
                    android:textColor="@color/st_accent"
                    android:textSize="13sp"
                    android:textStyle="italic"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/etMessageInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="Share a prayer..."
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="5"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="12dp"
                    android:textColor="@color/st_text"
                    android:textColorHint="@color/st_text_3"
                    android:textSize="16sp" />

                <LinearLayout
                    android:id="@+id/layoutRecordingUI"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp"
                    android:visibility="gone">

                    <ImageButton
                        android:id="@+id/btnDiscardAudio"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center_vertical"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_st_trash"
                        app:tint="@color/st_danger" />

                    <TextView
                        android:id="@+id/tvRecordTimer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="00:00"
                        android:textColor="@color/st_accent"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnSendAudio"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/circle_background"
                        android:backgroundTint="#7E57C2"
                        android:src="@drawable/ic_st_send"
                        app:tint="#FFFFFF" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnSendOrRecord"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="2dp"
            android:src="@drawable/ic_st_mic"
            app:backgroundTint="#7E57C2"
            app:borderWidth="0dp"
            app:elevation="2dp"
            app:fabCustomSize="48dp"
            app:tint="#FFFFFF" />

    </LinearLayout>

</RelativeLayout>
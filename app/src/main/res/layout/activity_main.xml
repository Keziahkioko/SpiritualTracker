<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="40dp">

        <!-- Header Image -->
        <ImageView
            android:id="@+id/ivHeader"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:scaleType="centerCrop"
            android:src="@drawable/header_bg"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Dark Overlay -->
        <View
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:background="#40000000"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Logout icon -->
        <ImageView
            android:id="@+id/ivLogout"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:padding="10dp"
            android:src="@android:drawable/ic_lock_power_off"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#FFFFFF"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- "DAYS TOGETHER" label -->
        <TextView
            android:id="@+id/tvStreakTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/days_together"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp"
            android:letterSpacing="0.2"
            android:layout_marginTop="100dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Score number -->
        <TextView
            android:id="@+id/tvStreak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/default_score"
            android:textColor="#FFFFFF"
            android:textSize="72sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvStreakTitle" />

        <!-- 2x2 GRID OF HABITS -->
        <GridLayout
            android:id="@+id/gridHabits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-40dp"
            android:columnCount="2"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/ivHeader">

            <!-- Bible Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardBible"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@android:color/transparent">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/card_premium_bg">
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/holy_bible"
                            app:tint="#FFFFFF" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/label_bible"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#ffffff" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/badgeBible"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/badge_bg"
                        android:gravity="center"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- Prayer Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardPrayer"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@android:color/transparent">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/card_premium_bg">
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/prayer"
                            app:tint="#FFFFFF" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/label_prayer"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#ffffff" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/badgePrayer"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/badge_bg"
                        android:gravity="center"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- Journal Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardJournal"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@android:color/transparent">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/card_premium_bg"
                        android:gravity="center"
                        android:orientation="vertical">
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/journal"
                            app:tint="#FFFFFF" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/label_journal"
                            android:textColor="#ffffff"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/badgeJournal"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/badge_bg"
                        android:gravity="center"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- Memory Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardMemory"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@android:color/transparent">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/card_premium_bg">
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/memorize"
                            app:tint="#FFFFFF" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/label_memorize"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#ffffff" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/badgeMemory"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/badge_bg"
                        android:gravity="center"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>

        </GridLayout>

        <!-- TODAY'S PROGRESS -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardProgress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:layout_marginTop="0dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeColor="#EDE7F6"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/gridHabits"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Header row: label + column headers -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="TODAY'S PROGRESS"
                        android:textColor="#7E57C2"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <TextView
                            android:layout_width="38dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="You"
                            android:textColor="#B39DDB"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="38dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Partner"
                            android:textColor="#B39DDB"
                            android:textSize="11sp" />
                    </LinearLayout>
                </RelativeLayout>

                <!-- Bible row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/holy_bible"
                        android:layout_marginEnd="8dp"
                        app:tint="#7E57C2" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Bible"
                        android:textColor="#3D3459"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/progressBibleMe"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="14dp"
                        android:padding="3dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_progress_todo" />

                    <ImageView
                        android:id="@+id/progressBiblePartner"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:padding="3dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_progress_todo" />
                </LinearLayout>

                <!-- Prayer row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/prayer"
                        android:layout_marginEnd="8dp"
                        app:tint="#7E57C2" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Prayer"
                        android:textColor="#3D3459"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/progressPrayerMe"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="14dp"
                        android:padding="3dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_progress_todo" />

                    <ImageView
                        android:id="@+id/progressPrayerPartner"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:padding="3dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_progress_todo" />
                </LinearLayout>

                <!-- Journal row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/journal"
                        android:layout_marginEnd="8dp"
                        app:tint="#7E57C2" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Journal"
                        android:textColor="#3D3459"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/progressJournalMe"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="14dp"
                        android:padding="3dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_progress_todo" />

                    <ImageView
                        android:id="@+id/progressJournalPartner"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:padding="3dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_progress_todo" />
                </LinearLayout>

                <!-- Memorize row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/memorize"
                        android:layout_marginEnd="8dp"
                        app:tint="#7E57C2" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Memorize"
                        android:textColor="#3D3459"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/progressMemorizeMe"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="14dp"
                        android:padding="3dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_progress_todo" />

                    <ImageView
                        android:id="@+id/progressMemorizePartner"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:padding="3dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_progress_todo" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- THIS WEEK HEATMAP -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardWeek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeColor="#EDE7F6"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/cardProgress"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="THIS WEEK · READING TOGETHER"
                        android:textColor="#7E57C2"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />

                    <TextView
                        android:id="@+id/tvViewHistory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:padding="4dp"
                        android:text="All progress ›"
                        android:textColor="#5E35B1"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout android:id="@+id/hmMon" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/hmCellMon" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:text="M" android:textSize="12sp" android:textStyle="bold" android:background="@drawable/hm_none" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mon" android:textSize="10sp" android:textColor="#B39DDB" android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/hmTue" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/hmCellTue" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:text="T" android:textSize="12sp" android:textStyle="bold" android:background="@drawable/hm_none" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tue" android:textSize="10sp" android:textColor="#B39DDB" android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/hmWed" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/hmCellWed" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:text="W" android:textSize="12sp" android:textStyle="bold" android:background="@drawable/hm_none" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wed" android:textSize="10sp" android:textColor="#B39DDB" android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/hmThu" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/hmCellThu" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:text="T" android:textSize="12sp" android:textStyle="bold" android:background="@drawable/hm_none" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thu" android:textSize="10sp" android:textColor="#B39DDB" android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/hmFri" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/hmCellFri" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:text="F" android:textSize="12sp" android:textStyle="bold" android:background="@drawable/hm_none" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fri" android:textSize="10sp" android:textColor="#B39DDB" android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/hmSat" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/hmCellSat" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:text="S" android:textSize="12sp" android:textStyle="bold" android:background="@drawable/hm_none" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sat" android:textSize="10sp" android:textColor="#B39DDB" android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/hmSun" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/hmCellSun" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:text="S" android:textSize="12sp" android:textStyle="bold" android:background="@drawable/hm_none" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sun" android:textSize="10sp" android:textColor="#B39DDB" android:layout_marginTop="4dp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Legend -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="14dp">

                    <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/hm_full" android:layout_marginEnd="4dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Both done" android:textSize="11sp" android:textColor="#9E9E9E" android:layout_marginEnd="14dp" />

                    <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/hm_half" android:layout_marginEnd="4dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Partial" android:textSize="11sp" android:textColor="#9E9E9E" android:layout_marginEnd="14dp" />

                    <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/hm_none" android:layout_marginEnd="4dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Missed" android:textSize="11sp" android:textColor="#9E9E9E" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<!-- Dark look: a plum outlined button before; the glossy purple once read. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:drawable="@drawable/bg_got_it" />
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2E2738" />
            <stroke android:width="1.5dp" android:color="#7A5AA8" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</selector>

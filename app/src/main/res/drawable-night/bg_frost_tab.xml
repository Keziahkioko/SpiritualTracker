<?xml version="1.0" encoding="utf-8"?>
<!-- The chosen tab in a frosted strip, Dark look: a soft lavender-white pill (pure white is too stark at night). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="270" android:startColor="#F1E9FF" android:endColor="#DCCBFA" />
    <stroke android:width="1dp" android:color="#80FFFFFF" />
    <corners android:radius="11dp" />
</shape>
